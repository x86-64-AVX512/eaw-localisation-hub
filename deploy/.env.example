# Public DNS name. Required only with: ./install.sh --tls
HUB_DOMAIN=hub.example.org

# The server itself remains available only on VPS loopback by default.
HUB_BIND_ADDRESS=127.0.0.1
HUB_PORT=3210

# Caddy needs public ports 80 and 443 for automatic certificates.
# If VLESS already owns 443, do not enable the bundled Caddy profile;
# route a subdomain to 127.0.0.1:3210 through the existing reverse proxy.
HUB_HTTP_PORT=80
HUB_HTTPS_PORT=443
